# ==============================================================================
# Environment Configuration for NASA OSDR ChatBot & AWG Evidence Engine
# ==============================================================================
# Copy this file to `.env` and populate keys as needed. All keys remain isolated
# in the Node.js backend (`server/env.ts`) and are never exposed to the browser.

# [RECOMMENDED] Google Gemini API Key
# Used server-side for Gemini chat streaming, image/video discovery, Computer Use, and Gemini TTS.
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
# Primary Text & Reasoning Model (Options: gemini-4-argon [Frontier 1M Reasoning Flagship], gemini-3.7-flash [Fast Balanced], gemini-2.5-flash [Low Latency])
GEMINI_TEXT_MODEL=gemini-4-argon

# [OPTIONAL - Secondary Text Fallback] OpenRouter API Key
# Cascaded to when Gemini quota is exhausted (429) or unavailable.
# Get a key at https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# [OPTIONAL - Tertiary Text Fallback] Groq API Key
# Cascaded to when both Gemini and OpenRouter are unavailable.
# Get a key at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# [OPTIONAL - Alternate Text-to-Speech Backend] OpenAI API Key
# Enables OpenAI TTS (`tts-1` / `alloy`) fallback when selected in Audio Controls.
OPENAI_API_KEY=

# ==============================================================================
# Firebase Authentication & Admin Portal Configuration
# ==============================================================================
# Client Web SDK Config (Public Firebase app identifiers; safe for browser use)
# Find these in Firebase Console -> Project Settings -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Optional local Firebase Auth Emulator host (e.g., http://127.0.0.1:9099)
VITE_FIREBASE_AUTH_EMULATOR_URL=

# Server-Only Firebase Admin SDK Credentials (NEVER prefix with VITE_)
# Option A: Full single-line JSON string from Firebase Console -> Service accounts
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: Individual service account fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server-Only Admin Access Control & Dedicated /admin Login Credentials
# Comma-separated verified emails allowed to access /admin (e.g., you@example.org)
ADMIN_EMAILS=
# Optional comma-separated Firebase UIDs granted admin role
ADMIN_UIDS=
# Optional dedicated admin username/email for direct /admin credential sign-in
ADMIN_USERNAME=
# Secondary admin passcode/password (server-verified; never committed to git)
ADMIN_PASSCODE=
# Optional dedicated HMAC signing secret for HttpOnly /admin sessions
ADMIN_SESSION_SECRET=

# ==============================================================================
# 8-Hour Release Radar Monitor & Webhooks (Ryan T. Scott & AWG Chairs)
# ==============================================================================
# Monitoring cadence in hours (default: 8 hours; in-app daemon + GitHub Actions)
RADAR_MONITOR_INTERVAL_HOURS=8
# Run an initial non-blocking upstream check shortly after server startup
RADAR_CHECK_ON_BOOT=true

# Outbound webhook target(s) notified automatically whenever new drops appear:
# Supports Discord webhooks, Slack incoming webhooks, or signed generic JSON URLs
RADAR_WEBHOOK_URL=
# Optional comma-separated list of multiple outbound webhook endpoints
RADAR_WEBHOOK_URLS=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Shared HMAC-SHA256 signing & Bearer auth secret for:
# - Outbound X-OSDR-Signature-256 header on generic JSON webhooks
# - Inbound authenticated POST /api/awg/radar/webhook and /webhook/test pushes
RADAR_WEBHOOK_SECRET=


