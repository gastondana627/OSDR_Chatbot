# ==============================================================================
# Environment Configuration for NASA OSDR ChatBot & AWG Evidence Engine
# ==============================================================================

# [REQUIRED for primary AI features] Google Gemini API Key
# Used server-side for Gemini chat streaming, RAG synthesis, Veo video discovery, and image generation.
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.7-flash

# [OPTIONAL - Secondary Text Fallback] OpenRouter API Key
# Cascaded to when Gemini quota is exhausted (429) or unavailable.
# Get a key at https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# [OPTIONAL - Tertiary Text Fallback] Groq API Key
# Cascaded to when both Gemini and OpenRouter are unavailable.
# Get a key at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

